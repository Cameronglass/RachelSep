{
  "name": "rachel-sepulveda-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12"},
  "scripts": {
    "build": "node --env-file-if-exists=.env cms/build.mjs",
    "build:local": "node cms/build.mjs --local",
    "test": "node --test cms/tests/*.test.mjs",
    "cms:export": "node cms/export.mjs",
    "cms:import": "sanity exec cms/import.mjs --with-user-token",
    "studio": "sanity dev --host 127.0.0.1",
    "studio:build": "sanity build studio-dist",
    "studio:deploy": "sanity deploy studio-dist",
    "preview": "node cms/serve.mjs"
  },
  "overrides": {
    "@vercel/frameworks": {"js-yaml": "3.15.2", "smol-toml": "1.8.0"},
    "@module-federation/dts-plugin": {"adm-zip": "0.6.1"},
    "typeid-js": {"uuid": "11.1.1"}
  },
  "devDependencies": {"playwright-core": "1.58.2"},
  "dependencies": {
    "@sanity/client": "8.6.1",
    "@sanity/image-url": "2.1.1",
    "cheerio": "1.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.13.2",
    "styled-components": "^6.1.19"
  }
}
