# These IDs are public. Use the same values for the website and editor.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Optional: set after choosing a unique Sanity-hosted Studio address.
SANITY_STUDIO_HOSTNAME=
# Only needed for a private dataset's build. The import uses Sanity CLI login.
# Never use a
# SANITY_STUDIO_ prefix for a token: those variables enter the browser bundle.
SANITY_API_TOKEN=
